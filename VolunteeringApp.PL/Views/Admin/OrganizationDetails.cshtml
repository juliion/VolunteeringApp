@using VolunteeringApp.DLL.Enums
@model VolunteeringApp.PL.ViewModels.Organization.OrganizationViewModel
@{
    ViewData["Title"] = @Model.Name + " Details";
    Layout = "_LayoutAdmin";
}

<div class="org-name-header">
    <h1>Детально про @Model.Name</h1>
</div>

<div class="organization-details">
    <table class="org-info-table">
        <tr>
            <th>Назва</th>
            <td>@Model.Name</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>@Model.Email</td>
        </tr>
        <tr>
            <th>Номер телефону</th>
            <td>@Model.PhoneNumber</td>
        </tr>
        <tr>
            <th>Опис</th>
            <td>@Model.Description</td>
        </tr>
        <tr>
            <th>Місто</th>
            <td>@Model.City</td>
        </tr>
        <tr>
            <th>Адреса</th>
            <td>@Model.Address</td>
        </tr>
        <tr>
            <th>Статус</th>
            <td>@Model.Status</td>
        </tr>
        <tr>
            <th>Зображення</th>
            <td><img src="@Url.Content("~/" + Model.PicturePath)" alt="@Model.Name"></td>
        </tr>
    </table>
    <table class="user-info-table">
        <tr>
            <th>Email користувача</th>
            <td>@Model.User.Email</td>
        </tr>
        <tr>
            <th>Ім'я користувача</th>
            <td>@Model.User.Name</td>
        </tr>
        <tr>
            <th>Прізвище користувача</th>
            <td>@Model.User.Surname</td>
        </tr>
        <tr>
            <th>Номер телефону користувача</th>
            <td>@Model.User.PhoneNumber</td>
        </tr>
    </table>
</div>
<div class="action-buttons actions-details">
    <button class="aproveBtn" data-id="@Model.Id" @(Model.Status == OrganizationStatus.Accepted ? "disabled" : "")>Схвалити</button>
    <button class="rejectedBtn" data-id="@Model.Id" @(Model.Status == OrganizationStatus.Rejected ? "disabled" : "")>Відхилити</button>
    <a href="@Url.Action("OrganizationsManagement", "Admin")">Повернутися до списку</a>
</div>

@section scripts {
    <script src="~/js/organizationActions.js"></script>
}

