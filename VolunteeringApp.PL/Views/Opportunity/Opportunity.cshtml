@using VolunteeringApp.BLL.DTOs.Opportunity
@using VolunteeringApp.PL.ViewModels.Enums
@model VolunteeringApp.PL.ViewModels.Opportunity.OpportunityViewModel
@{
    ViewData["Title"] = "Opportunity";
    Layout = "_LayoutMain";
}

<div class="container-opportunity">
    <div class="picture">
        @if (!string.IsNullOrEmpty(Model.PicturePath))
        {
            <img src="@Url.Content("~/" + Model.PicturePath)" alt="Opportunity Image">
        }
    </div>
    <div class="opportunity-data-section">
        <p class="category"><strong>@Model.Category.Name</strong></p>
        <h2>@Model.Name</h2>
        @if (@Model.Location == LocationType.Remotely)
        {
            <p><i class="fa-solid fa-location-dot"></i> Дистанційно</p>
        }
        else if (@Model.Location == LocationType.AllUkraine)
        {
            <p><i class="fa-solid fa-location-dot"></i> Вся Україна</p>
        }
        else
        {
            <p><i class="fa-solid fa-location-dot"></i> @Model.Location</p>
        }
        <p><i class="fa-regular fa-calendar-days"></i> @Model.StartTime - @Model.EndTime</p>
        <p><strong>Кінцева дата подачі заявки:</strong> @Model.ApplicationDeadline</p>
        <p>@Model.Description</p>
        <div class="organizer-section">
            <h4>Інформація про організатора та контакти</h4>
            @if (Model.UserOrganizer != null)
            {
                <p>@Model.UserOrganizer.Name</p>
            }
            @if (Model.OrganizationOrganizer != null)
            {
                <p><strong>Організація:</strong> @Model.OrganizationOrganizer.Name</p>
            }
            @if (!string.IsNullOrEmpty(Model.ContactsForApplications))
            {
                <p><strong>Контакти:</strong> @Model.ContactsForApplications</p>
            }
            @if (!string.IsNullOrEmpty(Model.FormForApplicationsPath))
            {
                <p><strong>Форма для подачі заявок:</strong> <a href="@Model.FormForApplicationsPath">Посилання</a></p>
            }
        </div>
    </div>
</div>